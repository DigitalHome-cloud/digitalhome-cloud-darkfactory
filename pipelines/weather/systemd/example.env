# /etc/dhc-weather/<branch>.env — one per backend (stage, main). Values come
# from the backend's stack: its storage bucket and its Area table
# (Area-<AppSync API id>-NONE). Not committed with real values.
WEATHER_LAKE=s3://<storage bucket>/public/weather
GOLD_S3=s3://<storage bucket>/public/weather/gold
AREA_TABLE=Area-<api id>-NONE
LOOKBACK_DAYS=10
AWS_REGION=eu-central-1
AWS_S3_ALLOW_UNSAFE_RENAME=true

# /etc/dhc-weather/host.env — the host's AWS configuration folder, mounted
# read-only into the container:
# AWS_DIR=/home/<user>/.aws
