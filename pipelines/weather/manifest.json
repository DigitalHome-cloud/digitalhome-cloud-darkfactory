{
  "description": "Semantic mapping of area weather + air-quality variables to Brick classes + QUDT units. Both tables are area-scoped (partition key area_id, year). Times are UTC.",
  "sources": {
    "weather": "open-meteo archive-api (ERA5), hourly, from 2000",
    "air_quality": "open-meteo air-quality-api (CAMS), hourly, from 2013",
    "solar_position": "computed via pvlib NREL SPA from (lat, lon, UTC time)"
  },
  "weather": {
    "temperature_2m":            {"brick": "brick:Outside_Air_Temperature_Sensor", "qudt": "unit:DEG_C"},
    "relative_humidity_2m":      {"brick": "brick:Outside_Air_Humidity_Sensor", "qudt": "unit:PERCENT"},
    "dew_point_2m":              {"brick": "brick:Dewpoint_Sensor", "qudt": "unit:DEG_C"},
    "apparent_temperature":      {"brick": "brick:Outside_Air_Temperature_Sensor", "qudt": "unit:DEG_C", "note": "feels-like"},
    "precipitation":             {"brick": "brick:Precipitation_Sensor", "qudt": "unit:MilliM"},
    "rain":                      {"brick": "brick:Rain_Sensor", "qudt": "unit:MilliM"},
    "snowfall":                  {"brick": "brick:Precipitation_Sensor", "qudt": "unit:CentiM", "note": "snow"},
    "pressure_msl":              {"brick": "brick:Barometric_Pressure_Sensor", "qudt": "unit:HectoPA", "note": "mean sea level"},
    "surface_pressure":          {"brick": "brick:Barometric_Pressure_Sensor", "qudt": "unit:HectoPA"},
    "cloud_cover":               {"brick": "brick:Weather_Condition", "qudt": "unit:PERCENT"},
    "wind_speed_10m":            {"brick": "brick:Wind_Speed_Sensor", "qudt": "unit:KiloM-PER-HR", "note": "10 m"},
    "wind_direction_10m":        {"brick": "brick:Wind_Direction_Sensor", "qudt": "unit:DEG", "note": "10 m"},
    "wind_gusts_10m":            {"brick": "brick:Wind_Speed_Sensor", "qudt": "unit:KiloM-PER-HR", "note": "gusts"},
    "wind_speed_100m":           {"brick": "brick:Wind_Speed_Sensor", "qudt": "unit:KiloM-PER-HR", "note": "100 m turbine hub height"},
    "wind_direction_100m":       {"brick": "brick:Wind_Direction_Sensor", "qudt": "unit:DEG", "note": "100 m"},
    "shortwave_radiation":       {"brick": "brick:Solar_Radiance_Sensor", "qudt": "unit:W-PER-M2", "note": "GHI global horizontal irradiance"},
    "direct_normal_irradiance":  {"brick": "brick:Solar_Radiance_Sensor", "qudt": "unit:W-PER-M2", "note": "DNI — key for tracker/concentrator PV"},
    "diffuse_radiation":         {"brick": "brick:Solar_Radiance_Sensor", "qudt": "unit:W-PER-M2", "note": "DHI diffuse horizontal"},
    "terrestrial_radiation":     {"brick": "brick:Solar_Radiance_Sensor", "qudt": "unit:W-PER-M2", "note": "top-of-atmosphere / clear-sky reference"},
    "sunshine_duration":         {"brick": "brick:Weather_Condition", "qudt": "unit:SEC", "note": "sunshine seconds in the hour"},
    "is_day":                    {"brick": "brick:Weather_Condition", "qudt": "unit:UNITLESS", "note": "1 day / 0 night"},
    "et0_fao_evapotranspiration":{"brick": "brick:Sensor", "qudt": "unit:MilliM", "note": "FAO reference ET0"},
    "solar_elevation":           {"brick": "brick:Position_Sensor", "qudt": "unit:DEG", "note": "sun elevation above horizon (computed)"},
    "solar_azimuth":             {"brick": "brick:Position_Sensor", "qudt": "unit:DEG", "note": "sun azimuth, 0=N 180=S (computed)"},
    "solar_zenith":              {"brick": "brick:Position_Sensor", "qudt": "unit:DEG", "note": "sun zenith angle (computed)"}
  },
  "air_quality": {
    "pm10":                 {"brick": "brick:PM10_Sensor", "qudt": "unit:MicroGM-PER-M3"},
    "pm2_5":                {"brick": "brick:PM2.5_Sensor", "qudt": "unit:MicroGM-PER-M3"},
    "nitrogen_dioxide":     {"brick": "brick:NO2_Level_Sensor", "qudt": "unit:MicroGM-PER-M3"},
    "ozone":                {"brick": "brick:Ozone_Level_Sensor", "qudt": "unit:MicroGM-PER-M3"},
    "sulphur_dioxide":      {"brick": "brick:Gas_Sensor", "qudt": "unit:MicroGM-PER-M3", "note": "SO2"},
    "carbon_monoxide":      {"brick": "brick:CO_Sensor", "qudt": "unit:MicroGM-PER-M3"},
    "dust":                 {"brick": "brick:Particulate_Matter_Sensor", "qudt": "unit:MicroGM-PER-M3"},
    "aerosol_optical_depth":{"brick": "brick:Weather_Condition", "qudt": "unit:UNITLESS"},
    "uv_index":             {"brick": "brick:UV_Sensor", "qudt": "unit:UNITLESS"}
  }
}
